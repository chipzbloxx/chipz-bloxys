<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Chipz Bloxys</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background: #050505;
  color: white;
}

header {
  background: #090909;
  border-bottom: 2px solid #e00000;
  padding: 22px;
  text-align: center;
}

header h1 {
  color: #ff2020;
  font-size: 42px;
  text-shadow: 0 0 15px #ff0000;
}

header p {
  color: #aaa;
  margin-top: 5px;
}

nav {
  margin-top: 18px;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 0 12px;
  font-weight: bold;
}

nav a:hover {
  color: #ff2020;
}

.hero {
  text-align: center;
  padding: 70px 20px;
  background: linear-gradient(#080808, #160000);
}

.hero h2 {
  font-size: 45px;
  margin-bottom: 15px;
}

.hero span {
  color: #ff2020;
}

.hero p {
  color: #aaa;
  max-width: 650px;
  margin: auto;
  line-height: 1.6;
}

.button {
  display: inline-block;
  margin-top: 25px;
  padding: 14px 28px;
  background: #e00000;
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: bold;
  box-shadow: 0 0 20px #8b0000;
}

.section {
  max-width: 1100px;
  margin: auto;
  padding: 55px 20px;
}

.section h2 {
  text-align: center;
  font-size: 34px;
  margin-bottom: 30px;
}

.search-box {
  width: 100%;
  max-width: 650px;
  display: block;
  margin: 0 auto 30px auto;
  padding: 17px 20px;
  border-radius: 10px;
  border: 1px solid #333;
  background: #111;
  color: white;
  font-size: 16px;
  outline: none;
}

.search-box:focus {
  border-color: #ff2020;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.card {
  background: #101010;
  border: 1px solid #292929;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
  transition: 0.2s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: #e00000;
  box-shadow: 0 0 20px #330000;
}

.game-button {
  width: 100%;
  background: #111;
  color: white;
  border: 1px solid #333;
  border-radius: 10px;
  padding: 22px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.game-button:hover {
  background: #1b0000;
  border-color: #ff2020;
}

.back-button {
  display: block;
  margin: 0 auto 25px auto;
  background: #e00000;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px 22px;
  cursor: pointer;
  font-weight: bold;
}

.item-card {
  background: #101010;
  border: 1px solid #292929;
  border-radius: 12px;
  padding: 22px;
  transition: 0.2s;
}

.item-card:hover {
  border-color: #ff2020;
}

.item-card h3 {
  color: white;
  margin-bottom: 8px;
}

.item-type {
  color: #888;
  font-size: 14px;
  margin-bottom: 12px;
}

.price {
  color: #35e66b;
  font-size: 20px;
  font-weight: bold;
}

.hidden {
  display: none;
}

footer {
  text-align: center;
  padding: 35px;
  background: #090909;
  border-top: 1px solid #222;
  color: #777;
}

footer strong {
  color: #ff2020;
}
</style>
</head>

<body>

<header>
  <h1>CHIPZ BLOXYS</h1>
  <p>Your Roblox Marketplace</p>

  <nav>
    <a href="#home">Home</a>
    <a href="#games">Game Items</a>
  </nav>
</header>

<section class="hero" id="home">

  <h2>WELCOME TO <span>CHIPZ BLOXYS</span></h2>

  <p>
    Find Roblox game items, collectibles, weapons,
    pets, clothing and more.
  </p>

  <a href="#games" class="button">BROWSE GAME ITEMS</a>

</section>

