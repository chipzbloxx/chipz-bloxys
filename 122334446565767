function showGames() {

  document.getElementById("gamesPage").classList.remove("hidden");

  document.getElementById("itemsPage").classList.add("hidden");

  document.getElementById("gameSearch").value = "";

  displayGames(games);
}

function displayGames(list) {

  const container = document.getElementById("gameList");

  container.innerHTML = "";

  if (list.length === 0) {

    container.innerHTML =
      "<p style='text-align:center;color:#888;'>No games found.</p>";

    return;
  }

  list.forEach((game, index) => {

    const button = document.createElement("button");

    button.className = "game-button";

    button.innerHTML =
      `${game.icon} &nbsp; ${game.name}`;

    button.onclick = function() {

      showItems(index);

    };

    const wrapper = document.createElement("div");

    wrapper.className = "card";

    wrapper.appendChild(button);

    container.appendChild(wrapper);

  });

}

function searchGames() {

  const search =
    document.getElementById("gameSearch")
    .value
    .toLowerCase();

  const filtered = games.filter(game =>
    game.name.toLowerCase().includes(search)
  );

  displayGames(filtered);

}

function showItems(gameIndex) {

  const game = games[gameIndex];

  document.getElementById("gamesPage")
    .classList.add("hidden");

  document.getElementById("itemsPage")
    .classList.remove("hidden");

  document.getElementById("selectedGame")
    .innerText = game.icon + " " + game.name;

  displayItems(game.items);

}

function displayItems(items) {

  const container =
    document.getElementById("itemList");

  container.innerHTML = "";

  if (items.length === 0) {

    container.innerHTML =
      "<p style='text-align:center;color:#888;'>No items found.</p>";

    return;

  }

  items.forEach(item => {

    const card =
      document.createElement("div");

    card.className = "item-card";

    card.innerHTML = `

      <h3>${item.name}</h3>

      <div class="item-type">
        ${item.type}
      </div>

      <div class="price">
        ${item.price}
      </div>

    `;

    container.appendChild(card);

  });

}

function searchItems() {

  const search =
    document.getElementById("itemSearch")
    .value
    .toLowerCase();

  const gameName =
    document.getElementById("selectedGame")
    .innerText;

  const game =
    games.find(g =>
      gameName.includes(g.name)
    );

  if (!game) return;

  const filtered =
    game.items.filter(item =>
      item.name.toLowerCase().includes(search) ||
      item.type.toLowerCase().includes(search)
    );

  displayItems(filtered);

}

window.onload = function() {

  showGames();

};

</script>

<section class="section" id="gamesPage">

  <h2>🎮 GAME ITEMS</h2>

  <input
    id="gameSearch"
    class="search-box"
    type="text"
    placeholder="🔎 Search for a Roblox game..."
    oninput="searchGames()"
  >

  <div
    id="gameList"
    class="grid">
  </div>

</section>

<section
  class="section hidden"
  id="itemsPage">

  <button
    class="back-button"
    onclick="showGames()">

    ← Back To Games

  </button>

  <h2 id="selectedGame"></h2>

  <input
    id="itemSearch"
    class="search-box"
    type="text"
    placeholder="🔎 Search items..."
    oninput="searchItems()"
  >

  <div
    id="itemList"
    class="grid">
  </div>

</section>

