<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chipz Bloxys — Roblox Marketplace</title>
  <meta name="description" content="Chipz Bloxys — Roblox limiteds, game items and clothing.">
  <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="nav">
  <a class="brand" href="#home">
    <span>CHIPZ</span> BLOXYS
  </a>

  <nav>
    <a href="#home">Home</a>
    <a href="#marketplace">Marketplace</a>
    <a href="#categories">Categories</a>
    <a href="#community">Community</a>
  </nav>

  <a class="nav-btn" href="#marketplace">Shop Now</a>
</header>


<main>

<section id="home" class="hero">

  <div class="hero-glow"></div>

  <div class="hero-copy">

    <p class="eyebrow">ROBLOX MARKETPLACE</p>

    <h1>
      LEVEL UP<br>
      <span>YOUR ROBLOX</span>
    </h1>

    <p class="hero-text">
      Discover limiteds, game items, clothing and more —
      all in one place.
    </p>

    <div class="hero-actions">
      <a class="primary" href="#marketplace">
        Explore Marketplace
      </a>

      <a
        class="secondary"
        href="https://discord.gg/ZJJF9qU8j"
        target="_blank"
      >
        Join Discord
      </a>
    </div>

    <div class="stats">

      <div>
        <strong>03</strong>
        <small>Categories</small>
      </div>

      <div>
        <strong>24/7</strong>
        <small>Community</small>
      </div>

      <div>
        <strong>⚡</strong>
        <small>Fresh Drops</small>
      </div>

    </div>

  </div>


  <div class="hero-art">

    <div class="orbit orbit-a"></div>
    <div class="orbit orbit-b"></div>

    <div class="character-card">

      <div class="character">

        <div class="head"></div>
        <div class="body"></div>

        <div class="arm left"></div>
        <div class="arm right"></div>

        <div class="leg left"></div>
        <div class="leg right"></div>

      </div>

      <div class="card-label">
        CHIPZ<br>
        <span>BLOXYS</span>
      </div>

    </div>

  </div>

</section>


<section id="marketplace" class="section">

  <div class="section-head">

    <div>
      <p class="eyebrow">SHOP</p>
      <h2>Marketplace</h2>
    </div>

    <div class="search-wrap">
      <input
        id="search"
        type="search"
        placeholder="Search items..."
      >
    </div>

  </div>

  <div id="products" class="products"></div>

  <p id="empty" class="empty" hidden>
    No items match your search.
  </p>

</section>


<section id="categories" class="section categories">

  <p class="eyebrow">BROWSE</p>

  <h2>Pick Your Category</h2>

  <div class="category-grid">

    <button
      class="category"
      data-filter="Limiteds"
    >
      <span>💎</span>
      <b>Limiteds</b>
      <small>Rare Roblox items</small>
    </button>


    <button
      class="category"
      data-filter="Game Items"
    >
      <span>🎮</span>
      <b>Game Items</b>
      <small>Items for your favorite games</small>
    </button>


    <button
      class="category"
      data-filter="Clothing"
    >
      <span>👕</span>
      <b>Clothing</b>
      <small>Fits for your avatar</small>
    </button>

  </div>

</section>


<section id="community" class="community">

  <div>

    <p class="eyebrow">
      JOIN THE COMMUNITY
    </p>

    <h2>
      Stay connected with<br>
      <span>CHIPZ BLOXYS</span>
    </h2>

    <p>
      Get updates, new drops, announcements
      and community news.
    </p>

  </div>


  <div class="community-actions">

    <a
      class="discord"
      href="https://discord.gg/ZJJF9qU8j"
      target="_blank"
    >
      💬 Join Discord
    </a>

    <a
      class="tiktok"
      href="https://www.tiktok.com/@chipzbloxx"
      target="_blank"
    >
      ♪ Follow @chipzbloxx
    </a>

  </div>

</section>

</main>


<footer>

  <div class="brand">
    <span>CHIPZ</span> BLOXYS
  </div>

  <p>
    © 2026 Chipz Bloxys. Fan-made marketplace concept.
  </p>

  <p class="fine">
    Roblox is a trademark of Roblox Corporation.
    Chipz Bloxys is not affiliated with or endorsed by
    Roblox Corporation.
  </p>

</footer>


<script src="script.js"></script>

</body>
</html>
